{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_STANDARD": "11",
        "CMAKE_CXX_STANDARD": "23"
      }
    },

    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "msvc",
      "displayName": "MSVC - Visual Studio generator, Debug and Release in one tree",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/msvc"
      }
    },

    {
      "name": "gcc",
      "displayName": "GCC - Ninja, Debug (gcc/g++ must be on PATH: MinGW-w64 on Windows, system GCC on Linux)",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build/gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/gcc"
      }
    },

    {
      "name": "gcc-release",
      "displayName": "GCC - Ninja, Release",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/gcc-release"
      }
    },

    {
      "name": "clang",
      "displayName": "Clang - Ninja, Debug (clang and clang++ must be on PATH)",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/clang"
      }
    },

    {
      "name": "clang-release",
      "displayName": "Clang - Ninja, Release",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/clang-release"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "jobs": 0
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "jobs": 0
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "jobs": 0
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "jobs": 0
    }
  ],

  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
